# Copy to .env for runs on the host: `cp .env.example .env`.
# `docker compose up --build` needs no .env file. Compose defaults every value below.
# All values here are development-only. The application refuses them when ENVIRONMENT=production.

ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://eve:eve-dev-password@localhost:5432/eve
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
WEBHOOK_SECRET=dev-only-webhook-secret-change-me-0123456789

# The seed script creates this admin (it refuses a placeholder password in production).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=dev-only-admin-password

# The tests create this database if it is missing. The role needs CREATEDB.
TEST_DATABASE_URL=postgresql+psycopg://eve:eve-dev-password@localhost:5432/eve_test

# Uncomment to change a default:
# PASSWORD_MIN_LENGTH=15
# WEBHOOK_SIGNATURE_REQUIRED=true
# PAYMENT_SUCCESS_RATE=0.8
# LOG_FORMAT=json
# API_PORT=8000      # the port that compose publishes for the API
# DB_PORT=5432       # the port that `make db` publishes for the database
